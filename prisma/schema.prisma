generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("VIEWER") // "ADMIN" | "EDITOR" | "VIEWER"
  avatarDataUrl String?  @db.Text
  createdAt     DateTime @default(now())
}

model UploadLog {
  id             Int      @id @default(autoincrement())
  filename       String
  uploadedByName String?
  itemsUpdated   Int      @default(0)
  itemsAdded     Int      @default(0)
  itemsUntouched Int      @default(0)
  createdAt      DateTime @default(now())
}

model Item {
  id           Int      @id @default(autoincrement())
  seedIndex    Int?     @unique // stable row position from the source file, used to merge re-uploads
  code         String
  description  String
  category     String
  uom          String
  packingSize  String?
  currentStock Float    @default(0)
  avgPerDay    Float    @default(0)
  runoutDays   Float?
  runoutDate   String?
  discontinued Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  months       MonthlyMovement[]
  transactions Transaction[]

  @@index([category])
  @@index([code])
}

// Historical + live monthly totals. "baseline*" fields record what the last
// uploaded/seeded file said for that month, so a future re-upload can be
// merged as a DELTA on top of whatever GRN/Usage/Damage entries were logged
// in the app since -- re-uploading never erases manually logged entries.
model MonthlyMovement {
  id      Int    @id @default(autoincrement())
  itemId  Int
  item    Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  month   String // e.g. "2026-01"
  opening Float  @default(0)
  added   Float  @default(0)
  usage   Float  @default(0)
  damage  Float  @default(0)
  closing Float  @default(0)

  baselineOpening Float   @default(0)
  baselineAdded   Float   @default(0)
  baselineUsage   Float   @default(0)
  baselineDamage  Float   @default(0)
  baselineSet     Boolean @default(false)

  @@unique([itemId, month])
}

// Live entries logged from the app: GRN (received), USAGE (consumed), DAMAGE (spoilage/loss).
// These are never touched by a file re-upload.
model Transaction {
  id            Int      @id @default(autoincrement())
  itemId        Int
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          String   // "GRN" | "USAGE" | "DAMAGE"
  quantity      Float
  date          DateTime
  note          String?
  source        String   @default("manual") // "manual" | "historical-import"
  sourceBalance Float?   // balance exactly as recorded in the original bin-card row, when known
  createdAt     DateTime @default(now())

  @@index([itemId])
  @@index([date])
}
